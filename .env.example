# Copy to .env / set in Render/Railway dashboard. NEVER commit real keys.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hlsp_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
PORT=8080

# Razorpay (https://dashboard.razorpay.com/app/keys) - leave blank for mock UPI flow
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp / SMS (MSG91 / Twilio / Meta) - leave blank for log-only notifications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
MSG91_API_KEY=
MSG91_SENDER_ID=HLSPIN

# Maps
GOOGLE_MAPS_API_KEY=
DEFAULT_CITY=Premnagar, Dehradun
DEFAULT_LAT=30.3429
DEFAULT_LNG=77.9620
OTP_DEV_EXPOSE=false   # true only locally: returns OTP in API for testing
WALLET_COMMISSION_PERCENT=20
